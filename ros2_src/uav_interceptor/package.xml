<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematyns="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_interceptor</name>
  <version>0.0.1</version>
  <description>ROS2 package for UAV Interceptor Visual Servoing</description>
  <maintainer email="alex@example.com">Alex</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>image_transport</depend>

  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>